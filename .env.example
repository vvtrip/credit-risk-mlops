# Runtime paths
CREDIT_RISK_ARTIFACT_DIR=artifacts
CREDIT_RISK_DATA_DIR=data/raw
CREDIT_RISK_REFERENCE_PATH=data/reference.csv

# MLflow and model promotion
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_MODEL_NAME=credit-risk-production
MLFLOW_MODEL_ALIAS=champion

# Dataset source can be replaced by an approved mirror
CREDIT_RISK_DATASET_URL=https://archive.ics.uci.edu/static/public/144/statlog+german+credit+data.zip

# Local Compose ports
API_PORT=8000
MLFLOW_PORT=5000
